      nameZh: "\u5764"
      titleZh: "\u7ED9\u81EA\u5DF1\u4E00\u70B9\u4F59\u5730"
      bodyZh: "\u4E00\u5F20\u7A7A\u6905\u3001\u4E00\u6BB5\u6C89\u9ED8\uFF0C\u4E5F\u53EF\u4EE5\u662F\u8BA4\u771F\u7167\u6599\u751F\u6D3B\u7684\u65B9\u5F0F\u3002\u4F60\u4E0D\u5FC5\u7ACB\u523B\u628A\u6BCF\u4E2A\u7A7A\u9699\u586B\u6EE1\u3002\u4ECA\u5929\u82E5\u6709\u4E00\u4EF6\u4E8B\u5C1A\u672A\u51B3\u5B9A\uFF0C\u5148\u8BA9\u5B83\u5728\u90A3\u91CC\uFF0C\u518D\u770B\u770B\u81EA\u5DF1\u9700\u8981\u600E\u6837\u7684\u7A7A\u95F4\u3002\u8FD9\u4E0D\u662F\u653E\u5F03\uFF0C\u800C\u662F\u5141\u8BB8\u81EA\u5DF1\u5728\u770B\u6E05\u4E4B\u524D\uFF0C\u6682\u65F6\u4E0D\u628A\u7B54\u6848\u8BF4\u6EE1\u3002"
      promptZh: "\u4ECA\u5929\u6709\u4EC0\u4E48\u53EF\u4EE5\u4E0D\u6025\u7740\u586B\u6EE1\uFF1F"
      kingWenId: 2
    - key: 100_000
      lowerBits: 100
      upperBits: 000
      nameZh: "\u590D"
      titleZh: "\u4ECE\u5C0F\u5904\u56DE\u6765"
      bodyZh: "\u91CD\u65B0\u5F00\u59CB\u4E0D\u4E00\u5B9A\u9700\u8981\u4E00\u4E2A\u5B8F\u5927\u7684\u51B3\u5B9A\u3002\u628A\u676F\u5B50\u6D17\u51C0\uFF0C\u6253\u5F00\u7A97\uFF0C\u6216\u56DE\u5230\u4E00\u4EF6\u66FE\u8BA9\u4F60\u5B89\u7A33\u7684\u5C0F\u4E8B\uFF0C\u90FD\u662F\u53EF\u4EE5\u53D1\u751F\u7684\u8D77\u70B9\u3002\u4ECA\u5929\u4E0D\u7528\u8865\u9F50\u6240\u6709\u9519\u8FC7\u7684\u8FDB\u5EA6\u3002\u53EA\u505A\u4E00\u4EF6\u8BA9\u4F60\u613F\u610F\u518D\u56DE\u6765\u4E00\u6B21\u7684\u4E8B\uFF0C\u4E5F\u53EF\u4EE5\u3002"
      promptZh: "\u54EA\u4EF6\u5F88\u5C0F\u7684\u4E8B\uFF0C\u80FD\u8BA9\u4F60\u91CD\u65B0\u5F00\u59CB\uFF1F"
      kingWenId: 24
    - key: 010_000
      lowerBits: 010
      upperBits: 000
      nameZh: "\u5E08"
      titleZh: "\u8BA9\u4E8B\u60C5\u5404\u5C31\u5176\u4F4D"
      bodyZh: "\u5F53\u8BB8\u591A\u4E8B\u60C5\u4E00\u8D77\u5230\u6765\uFF0C\u53EF\u4EE5\u5148\u5206\u6E05\u8F7B\u91CD\uFF0C\u518D\u51B3\u5B9A\u7531\u8C01\u627F\u62C5\u3002\u4F60\u4E0D\u5FC5\u4E00\u4E2A\u4EBA\u7AD9\u5728\u6240\u6709\u4F4D\u7F6E\u4E0A\u3002\u4ECA\u5929\u8BD5\u7740\u628A\u4E00\u4EF6\u9700\u8981\u534F\u4F5C\u7684\u4E8B\u8BF4\u6E05\u695A\uFF0C\u7559\u51FA\u522B\u4EBA\u56DE\u5E94\u7684\u7A7A\u95F4\u3002\u5B89\u6392\u4E0D\u662F\u63A7\u5236\u4E00\u5207\uFF0C\u800C\u662F\u8BA9\u6709\u9650\u7684\u529B\u6C14\u6709\u5730\u65B9\u843D\u4E0B\u3002"
      promptZh: "\u54EA\u4E00\u4EF6\u4E8B\u53EF\u4EE5\u8BF7\u522B\u4EBA\u4E00\u8D77\u627F\u62C5\uFF1F"
      kingWenId: 7
    - key: 110_000
      lowerBits: 110
      upperBits: 000
      nameZh: "\u4E34"
      titleZh: "\u9760\u8FD1\u4E00\u70B9"
      bodyZh: "\u9760\u8FD1\u4E00\u4E2A\u4EBA\uFF0C\u6709\u65F6\u4ECE\u4E0D\u6025\u7740\u7ED9\u7B54\u6848\u5F00\u59CB\u3002\u5148\u542C\u89C1\u5BF9\u65B9\u6B63\u5728\u8BF4\u4EC0\u4E48\uFF0C\u4E5F\u7559\u610F\u81EA\u5DF1\u662F\u5426\u6709\u4F59\u529B\u3002\u4ECA\u5929\u53EF\u4EE5\u5C1D\u8BD5\u4E00\u6B21\u7F13\u6162\u800C\u6E05\u695A\u7684\u56DE\u5E94\u3002\u6E29\u67D4\u4E0D\u8981\u6C42\u4F60\u7B54\u5E94\u6240\u6709\u4E8B\u60C5\uFF0C\u53EA\u8981\u6C42\u8FD9\u4E00\u6B21\u9760\u8FD1\u662F\u4F60\u613F\u610F\u7684\u3002"
      promptZh: "\u4F60\u613F\u610F\u5148\u542C\u5B8C\u8C01\u7684\u4E00\u53E5\u8BDD\uFF1F"
      kingWenId: 19
    - key: 001_000
      lowerBits: 001
      upperBits: 000
      nameZh: "\u8C26"
      titleZh: "\u4E0D\u5FC5\u628A\u81EA\u5DF1\u7F29\u5C0F"
      bodyZh: "\u5B89\u9759\u4E0D\u610F\u5473\u7740\u4F60\u505A\u8FC7\u7684\u4E8B\u6CA1\u6709\u5206\u91CF\u3002\u4F60\u53EF\u4EE5\u4E0D\u4E89\u62A2\u76EE\u5149\uFF0C\u4E5F\u4E0D\u5FC5\u628A\u81EA\u5DF1\u7684\u52AA\u529B\u85CF\u5230\u770B\u4E0D\u89C1\u3002\u4ECA\u5929\u7ED9\u4E00\u4EF6\u5DF2\u7ECF\u5B8C\u6210\u7684\u5C0F\u4E8B\u4E00\u4E2A\u51C6\u786E\u7684\u540D\u5B57\uFF0C\u627F\u8BA4\u5B83\u82B1\u8FC7\u4F60\u7684\u65F6\u95F4\u3002\u770B\u89C1\u81EA\u5DF1\uFF0C\u4E0D\u4F1A\u593A\u8D70\u522B\u4EBA\u5E94\u6709\u7684\u4F4D\u7F6E\u3002"
      promptZh: "\u4ECA\u5929\u6709\u4EC0\u4E48\u52AA\u529B\u503C\u5F97\u88AB\u4F60\u627F\u8BA4\uFF1F"
      kingWenId: 15
    - key: 101_000
      lowerBits: 101
      upperBits: 000
      nameZh: "\u660E\u5937"
      titleZh: "\u62A4\u4F4F\u4E00\u70B9\u5149"
      bodyZh: "\u5E76\u975E\u6BCF\u4E00\u675F\u5149\u90FD\u9700\u8981\u5728\u6B64\u523B\u7167\u5F97\u66F4\u8FDC\u3002\u6709\u65F6\u628A\u5B83\u5B89\u653E\u5728\u907F\u98CE\u5904\uFF0C\u6BD4\u52C9\u5F3A\u71C3\u70E7\u66F4\u5408\u9002\u3002\u4ECA\u5929\u53EF\u4EE5\u5173\u6389\u4E00\u9879\u4E0D\u5FC5\u8981\u7684\u6253\u6270\uFF0C\u6216\u628A\u4E00\u53E5\u5C1A\u672A\u60F3\u597D\u7684\u8BDD\u7559\u5230\u4EE5\u540E\u3002\u4FDD\u62A4\u7CBE\u529B\uFF0C\u4E5F\u662F\u4E00\u79CD\u8BA4\u771F\u5BF9\u5F85\u751F\u6D3B\u7684\u65B9\u5F0F\u3002"
      promptZh: "\u54EA\u4E00\u4E2A\u8FB9\u754C\u80FD\u8BA9\u4F60\u4FDD\u5B58\u7CBE\u529B\uFF1F"
