    - key: 011_000
      lowerBits: 011
      upperBits: 000
      nameZh: "\u5347"
      titleZh: "\u8BA9\u4E00\u6B65\u6210\u4E3A\u4E00\u6B65"
      bodyZh: "\u6709\u4E9B\u53D8\u5316\u5728\u4E00\u5929\u91CC\u5F88\u96BE\u770B\u89C1\uFF0C\u5374\u4F1A\u5728\u4E00\u6B21\u6B21\u5C0F\u884C\u52A8\u4E2D\u7559\u4E0B\u75D5\u8FF9\u3002\u4ECA\u5929\u628A\u76EE\u6807\u7F29\u5230\u53EF\u4EE5\u5F00\u59CB\u7684\u5927\u5C0F\uFF0C\u5B8C\u6210\u4E4B\u540E\u505C\u4E0B\u6765\u770B\u770B\u3002\u4F60\u4E0D\u9700\u8981\u5148\u8BC1\u660E\u7EC8\u70B9\u4E00\u5B9A\u503C\u5F97\uFF0C\u624D\u5141\u8BB8\u81EA\u5DF1\u8FC8\u51FA\u8FD9\u4E00\u6B65\u3002"
      promptZh: "\u4ECA\u5929\u53EF\u4EE5\u5B8C\u6210\u7684\u6700\u5C0F\u4E00\u6B65\u662F\u4EC0\u4E48\uFF1F"
