      bodyZh: "\u5F53\u8BDD\u80FD\u591F\u6765\u56DE\u6D41\u52A8\uFF0C\u8BB8\u591A\u4E8B\u60C5\u4F1A\u677E\u5F00\u4E00\u70B9\u3002\u4ECA\u5929\u53EF\u4EE5\u6E05\u695A\u5730\u8BF4\u51FA\u4E00\u4E2A\u9700\u8981\uFF0C\u4E5F\u4E3A\u5BF9\u65B9\u4FDD\u7559\u4E0D\u540C\u7684\u56DE\u7B54\u3002\u987A\u7545\u4E0D\u7B49\u4E8E\u6C38\u8FDC\u6CA1\u6709\u5206\u6B67\uFF0C\u800C\u662F\u53CC\u65B9\u4ECD\u613F\u610F\u4E3A\u5F7C\u6B64\u7559\u4E00\u6761\u80FD\u8D70\u8FC7\u53BB\u7684\u8DEF\u3002"
      promptZh: "\u4F60\u5E0C\u671B\u54EA\u4E00\u6B21\u6C9F\u901A\u66F4\u8F7B\u4E00\u70B9\uFF1F"
