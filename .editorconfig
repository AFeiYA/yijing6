root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{json,asmdef}]
indent_style = space
indent_size = 2

# Unity writes a trailing space for empty serialized fields.
[*.{meta,unity,asset,prefab,scenetemplate}]
trim_trailing_whitespace = false
